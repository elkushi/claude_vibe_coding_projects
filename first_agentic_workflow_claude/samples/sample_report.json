    "findings": [
      {
        "text": "Sample finding. Price is fixed by the regulator, so competitors differentiate on reach, reliability and relationships — not on rate.",
        "source_ids": [
          "S3"
        ]
      },
      {
        "text": "Sample finding. The strongest local player owns the banking segment through a decade-old SMS-banking platform.",
        "source_ids": [
          "S4"
        ]
      },
      {
        "text": "Sample finding. International CPaaS providers reach Bangladesh only through local licensed partners.",
        "source_ids": [
          "S9",
          "S10"
        ]
      },
      {
        "text": "Sample finding. Example Co holds its own licence and three operator agreements — an asset most smaller rivals lack.",
        "source_ids": [
          "INT"
        ]
      }
    ],
    "bottom_line": "Sample bottom line. Example Co's entry case rests on being the only licensed local aggregator with a working multichannel cascade. The first 12 months should prove it with two or three reference enterprise clients."
  },
